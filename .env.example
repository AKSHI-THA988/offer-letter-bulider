# OfferFlow Environment Variables
# Copy to .env and fill in your values

PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=offerflow
DB_USER=postgres
DB_PASS=yourpassword

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string_in_production

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
